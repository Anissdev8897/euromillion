# Configuration pour le système EuroMillions

# Port et host du serveur (en production, lier à 127.0.0.1 derrière un proxy)
PORT=5002
HOST=0.0.0.0
# NE PAS mettre "development" en production (expose la console de debug Werkzeug)
FLASK_ENV=production

# Type de jeu (euromillions ou loto)
GAME_TYPE=euromillions

# IP/host public du serveur (laisser vide par défaut ; renseigner au déploiement)
SERVER_IP=

ENABLE_AUTO_TRAINING=False
ENABLE_AUTO_UPDATE=True

# --- Sécurité (toutes opt-in : vides = comportement historique non cassé) ---
# Clé d'API : si définie, exigée via l'en-tête X-API-Key sur /api/predict.
API_KEY=
# Origines CORS autorisées (CSV). Vide = défauts sûrs (domaine + localhost).
CORS_ORIGINS=
# Rate-limiting par IP (req/min). Vide = désactivé. N'activer qu'avec un
# X-Forwarded-For fiable (voir TRUSTED_PROXIES), sinon limite globale.
RATE_LIMIT_PER_MIN=
# IP des proxies de confiance (CSV) dont on accepte le X-Forwarded-For.
TRUSTED_PROXIES=
# Chargement strict des modèles : 1 = refuse tout .pkl/.joblib non listé dans
# config/model_manifest.json (anti-RCE). Activer après avoir généré le manifeste.
EUROMILLIONS_STRICT_MODELS=

# Clés API tierces (Optionnel) — chargées via os.environ, jamais en dur.
OPENAI_API_KEY=
